# App
APP_NAME=Digital Twin Traffic Backend
APP_VERSION=0.1.0
APP_DESCRIPTION=Backend de simulacion para gemelo digital de trafico urbano
HOST=0.0.0.0
PORT=8000
DEBUG=true
LOG_LEVEL=INFO

# CORS (JSON list)
CORS_ORIGINS=["*"]

# Optional startup map in data/
MAP_FILE=

# Simulation
SIMULATION_TICK_RATE=0.1
MAX_VEHICLES=1000000000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dt_user
POSTGRES_PASSWORD=dt_password
POSTGRES_DB=digital_twin

# DB pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# PgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
